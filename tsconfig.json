{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./node.json",
    "compilerOptions": {
        "rootDir": "./",
        "outDir": "./dist",
        "skipLibCheck": true,
        "noImplicitAny": true,
        "types": ["node"],
        "resolveJsonModule": true
    },
    "include": ["src/**/*.ts", "seedcord.config.ts", "i18n/build.ts", "prisma.config.ts"],
    "exclude": ["node_modules", "dist"]
}
