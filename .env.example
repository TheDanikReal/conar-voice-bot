# REQUIRED: Your bot token, from the Bot page of your app in the Discord Developer Portal
DISCORD_BOT_TOKEN=""

# Discord webhooks the framework posts error reports to. Leave empty to skip reporting.
UNKNOWN_EXCEPTION_WEBHOOK_URL=
HANDLED_EXCEPTION_WEBHOOK_URL=

ENV=development

# REQUIRED: Postgres database url
DATABASE_URL=""

# optional, used for lavalink, if not there, disables music
LAVALINK_URL=
LAVALINK_PASS=