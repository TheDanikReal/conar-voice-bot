{
    "name": "bot",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24.11"
    },
    "scripts": {
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "lint": "eslint 'src/**/*.ts' --cache",
        "lint:fix": "eslint 'src/**/*.ts' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,json,md}' --cache",
        "tc": "tsc --noEmit"
    },
    "dependencies": {
        "@discordjs/builders": "^1.14.1",
        "@prisma/adapter-pg": "^7.9.1",
        "@prisma/client": "^7.9.1",
        "@seedcord/gateway": "^0.1.4",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "envapt": "^8.1.1",
        "lru-cache": "^11.5.2",
        "prisma": "^7.9.1"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "^1.5.3",
        "@seedcord/tsconfig": "^2.0.2",
        "@types/node": "^26.2.0",
        "prettier": "^3.9.6",
        "seedcord": "^0.17.4",
        "typescript": "~6.0.3"
    }
