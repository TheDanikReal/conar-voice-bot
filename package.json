{
    "name": "bot",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=26.12.1"
    },
    "scripts": {
        "prebuild": "node --strip-types i18n/build.ts && prisma contract emit && seedcord codegen",
        "prelint": "node --strip-types i18n/build.ts && prisma contract emit && seedcord codegen",
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "lint": "eslint 'src/**/*.ts' --cache",
        "lint:fix": "eslint 'src/**/*.ts' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,json,md}' --cache",
        "tc": "tsc --noEmit",
        "database:deploy": "prisma contract emit && prisma db migrate --advance-ref db"
    },
    "dependencies": {
        "@discordjs/builders": "^1.15.0",
        "@prisma/orm-postgres": "8.0.0-rc.11",
        "@seedcord/gateway": "^0.8.0",
        "discord.js": "^14.28.0",
        "dotenv": "^18.0.9",
        "envapt": "^9.2.0",
        "kazagumo": "^3.4.3",
        "lavalink-client": "^2.11.0",
        "lru-cache": "^11.5.3",
        "shoukaku": "^4.3.0"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "^3.0.0",
        "@seedcord/eslint-plugin": "^0.5.0",
        "@seedcord/tsconfig": "^3.0.0",
        "@types/node": "^26.6.6",
        "eslint-plugin-discordjs": "^0.2.0",
        "eslint-plugin-security": "^4.2.1",
        "eslint-plugin-tsdoc": "^0.5.4",
        "prettier": "^3.9.10",
        "prisma": "8.0.0-rc.15",
        "seedcord": "^0.22.0",
        "taze": "^21.3.0",
        "typescript": "~7.0.2"
    }
}
