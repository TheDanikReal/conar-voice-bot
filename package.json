{
    "name": "bot",
    "type": "module",
    "version": "0.1.0",
    "private": true,
    "engines": {
        "node": ">=24.11"
    },
    "scripts": {
        "prebuild": "node --strip-types i18n/build.ts && prisma contract emit && seedcord codegen",
        "prelint": "node --strip-types i18n/build.ts && prisma contract emit && seedcord codegen",
        "dev": "seedcord dev",
        "build": "seedcord build",
        "start": "node --enable-source-maps dist/index.mjs",
        "codegen": "seedcord codegen",
        "lint": "eslint 'src/**/*.ts' --cache",
        "lint:fix": "eslint 'src/**/*.ts' --fix --cache",
        "fmt": "prettier --write 'src/**/*.{ts,json,md}' --cache",
        "tc": "tsc --noEmit",
        "database:deploy": "prisma db migrate --advance-ref db && prisma contract emit"
    },
    "dependencies": {
        "@discordjs/builders": "^1.14.1",
        "@prisma/orm-postgres": "8.0.0-rc.11",
        "@seedcord/gateway": "^0.6.0",
        "discord.js": "^14.27.0",
        "dotenv": "^17.4.2",
        "envapt": "^8.2.1",
        "kazagumo": "^3.4.3",
        "lavalink-client": "^2.11.0",
        "lru-cache": "^11.5.2",
        "shoukaku": "^4.3.0"
    },
    "devDependencies": {
        "@seedcord/eslint-config": "^2.2.1",
        "@seedcord/eslint-plugin": "^0.4.0",
        "@seedcord/tsconfig": "^2.0.3",
        "@types/node": "^22.20.3",
        "eslint-plugin-discordjs": "^0.1.4",
        "eslint-plugin-security": "^4.0.1",
        "eslint-plugin-tsdoc": "^0.5.3",
        "prettier": "^3.9.7",
        "prisma": "8.0.0-rc.15",
        "seedcord": "^0.19.5",
        "typescript": "~6.0.3"
    }
}
