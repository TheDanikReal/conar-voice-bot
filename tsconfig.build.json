{
    "$schema": "https://json.schemastore.org/tsconfig",
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "outDir": "./dist",
        "noEmit": false,
        "module": "esnext",
        "moduleResolution": "bundler",
        "paths": {
            "#src/*": ["./src/*"],
            "#components/*": ["./src/components/*"]
        }
    },
    "include": ["src/**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
